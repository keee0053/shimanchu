# このファイルを .env.local にコピーして値を設定してください（.env.local は git 管理外）
# ローカル Supabase の場合は `supabase status` の「Project URL」と「Publishable」キーを使用
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ホストの Supabase につなぐ場合は、上の2行をコメントにして、下の2行のコメントを外す
# 値はダッシュボードの「Project URL」と「Publishable」キーを使用（docs/SETUP.md の 6-3）
# EXPO_PUBLIC_SUPABASE_URL=https://<プロジェクトID>.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
